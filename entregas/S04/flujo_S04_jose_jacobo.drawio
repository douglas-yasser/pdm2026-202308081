<mxfile host="app.diagrams.net">
  <diagram name="Flujo de pantallas" id="flujo-jose-jacobo">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Inicio -->
        <mxCell id="n_inicio" value="Registro rápido&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sueño y ejercicio de hoy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Detalle -->
        <mxCell id="n_detalle" value="Progreso semanal&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cuántos días cumpliste&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="160" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Decision diamond -->
        <mxCell id="n_decision" value="¿Cumpliste tu meta hoy?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#993C1D;fontColor=#4A1B0C;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="280" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Refuerzo (Sí) -->
        <mxCell id="n_refuerzo" value="Racha reforzada&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;muestra tu racha actual&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#173404;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="460" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Recordatorio (No) -->
        <mxCell id="n_recordatorio" value="Ajuste suave&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;un recordatorio breve&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#412402;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="460" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Cierre -->
        <mxCell id="n_cierre" value="Cierre sin culpa&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;solo seguimiento diario&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="580" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5F5E5A;" edge="1" parent="1" source="n_inicio" target="n_detalle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5F5E5A;" edge="1" parent="1" source="n_detalle" target="n_decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Sí" style="edgeStyle=none;rounded=0;html=1;endArrow=block;strokeColor=#3B6D11;fontColor=#3B6D11;fontStyle=1;" edge="1" parent="1" source="n_decision" target="n_refuerzo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="No" style="edgeStyle=none;rounded=0;html=1;endArrow=block;strokeColor=#854F0B;fontColor=#854F0B;fontStyle=1;" edge="1" parent="1" source="n_decision" target="n_recordatorio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=none;rounded=0;html=1;endArrow=block;strokeColor=#5F5E5A;" edge="1" parent="1" source="n_refuerzo" target="n_cierre">
          <mxGeometry relative="1" as="geometry" />
